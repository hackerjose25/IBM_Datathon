[Unit]
Description=ClaimGuard synthetic claims API
After=network.target

[Service]
Type=simple
User=linux1
WorkingDirectory=/home/linux1/claimguard
Environment=EXECUTION_TARGET=IBM_LINUXONE
ExecStart=/home/linux1/claimguard/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
