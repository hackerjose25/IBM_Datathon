# ==============================================================================
# ClaimGuard Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI & Engine)
# ------------------------------------------------------------------------------
# Server host & port
HOST=127.0.0.1
PORT=8000

# SQLite database file URL
DATABASE_URL=sqlite:///./claimguard.db

# Execution Target: LOCAL_MOCK | IBM_LINUXONE
EXECUTION_TARGET=LOCAL_MOCK

# Business Rule & Anomaly Thresholds
DUPLICATE_WINDOW_DAYS=30
ANOMALY_THRESHOLD_SCORE=60.0

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# REST API base URL
VITE_API_URL=http://localhost:8000

# WebSocket stream URL
VITE_WS_URL=ws://localhost:8000/ws/claims
