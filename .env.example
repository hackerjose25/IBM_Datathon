# ==============================================================================
# ClaimGuard Environment Configuration Template
# IBM Z Datathon 2026 - Track 01: Real-Time AI for Critical Decisions
# ==============================================================================

# ==============================================================================
# ACTIVE CONFIGURATION PROFILE
# Select: LOCAL_MOCK (Local dev/testing) or IBM_LINUXONE (LinuxONE s390x VM)
# ==============================================================================
EXECUTION_TARGET=LOCAL_MOCK

# ------------------------------------------------------------------------------
# Backend Server Configuration (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Host interface to bind (127.0.0.1 for local isolation, 0.0.0.0 for VM deployment)
HOST=127.0.0.1
PORT=8000

# SQLite database file URL (absolute or relative to repository root)
DATABASE_URL=sqlite:///./claimguard.db

# Path to versioned pre-trained Isolation Forest model artifact (.joblib)
MODEL_PATH=backend/ml/model.joblib

# Business Rule & Anomaly Thresholds
DUPLICATE_WINDOW_DAYS=30
ANOMALY_THRESHOLD_SCORE=60.0

# ------------------------------------------------------------------------------
# Frontend Dashboard Configuration (Vite + React)
# ------------------------------------------------------------------------------
# REST API base URL
VITE_API_URL=http://localhost:8000

# WebSocket live streaming endpoint
VITE_WS_URL=ws://localhost:8000/ws/claims

# ==============================================================================
# PROFILE REFERENCE: IBM LinuxONE (s390x) VM Deployment
# For LinuxONE staging/production demonstrations, set the following:
# ==============================================================================
# EXECUTION_TARGET=IBM_LINUXONE
# HOST=0.0.0.0
# PORT=8000
# DATABASE_URL=sqlite:///./claimguard.db
# MODEL_PATH=backend/ml/model.joblib
# DUPLICATE_WINDOW_DAYS=30
# ANOMALY_THRESHOLD_SCORE=60.0
# VITE_API_URL=http://<LINUXONE_HOST_IP_OR_DOMAIN>:8000
# VITE_WS_URL=ws://<LINUXONE_HOST_IP_OR_DOMAIN>:8000/ws/claims
